#: ../../../internals/ethdebug_internal_debug_info.rst:316
msgid "``Merge``"
msgstr ""

#: ../../../internals/ethdebug_internal_debug_info.rst:317
msgid ""
"Keep the surviving value's entry when two values or two blocks collapse into "
"one. Record the discarded declarations against the same program point so "
